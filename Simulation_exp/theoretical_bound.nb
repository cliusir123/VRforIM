Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Define", " ", "the", " ", "integrand"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"integrand", "[", 
     RowBox[{"x_", ",", "y_", ",", "\[Sigma]_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"y", "^", "2"}]}], "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", 
         RowBox[{"\[Sigma]", "^", "2"}]}], ")"}]}], "]"}], "*", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{"1", "/", "2"}], ")"}]}], " ", 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{"1", "/", 
             RowBox[{"\[Sigma]", "^", "2"}]}]}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"y", "^", "2"}], "-", 
            RowBox[{"x", "^", "2"}]}], ")"}]}], "]"}], "-", "1"}], ")"}], "^",
       "2"}], "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"y", "^", "2"}], "-", 
       RowBox[{"x", "^", "2"}]}], ")"}], "*", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", "\[Sigma]", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"x", "^", "2"}]}], "/", 
           RowBox[{"(", 
            RowBox[{"2", " ", 
             RowBox[{"\[Sigma]", "^", "2"}]}], ")"}]}], "]"}]}], "-", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"x", "^", "2"}]}], "/", "2"}], "]"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"\[Pi]", " ", "\[Sigma]"}], ")"}]}]}]}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Define", " ", "the", " ", "range", " ", "of", " ", "sigma", " ", 
     "values"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sigmaList", "=", 
     RowBox[{"N", "[", 
      RowBox[{"Range", "[", 
       RowBox[{"1.1", ",", "1.6", ",", "0.1"}], "]"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Compute", " ", "the", " ", "integral", " ", "and", " ", "VRF", " ", 
     "for", " ", "each", " ", "sigma"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"results", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Sigma]", "=", "s"}], ",", "integralValue", ",", "vrf"}],
           "}"}], ",", 
         RowBox[{
          RowBox[{"integralValue", "=", 
           RowBox[{"NIntegrate", "[", 
            RowBox[{
             RowBox[{"integrand", "[", 
              RowBox[{"x", ",", "y", ",", "\[Sigma]"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"y", ",", "0", ",", "6"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", 
               RowBox[{"-", "y"}], ",", "y"}], "}"}], ",", 
             RowBox[{"Method", "->", "\"\<GlobalAdaptive\>\""}], ",", 
             RowBox[{"MaxRecursion", "->", "10"}], ",", 
             RowBox[{"WorkingPrecision", "->", "20"}], ",", 
             RowBox[{"AccuracyGoal", "->", "8"}], ",", 
             RowBox[{"PrecisionGoal", "->", "8"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"vrf", "=", 
           RowBox[{"1", "/", "integralValue"}]}], ";", "\[IndentingNewLine]", 
          
          RowBox[{"{", 
           RowBox[{"\[Sigma]", ",", "integralValue", ",", "vrf"}], "}"}]}]}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"s", ",", "sigmaList"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Display", " ", "results", " ", "in", " ", "a", " ", "table"}], 
    "*)"}], "\n", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{"results", ",", 
       RowBox[{"{", 
        RowBox[{
        "\"\<\[Sigma]\>\"", ",", "\"\<Integral Value\>\"", ",", 
         "\"\<VRF (\[Sigma]\.b2 / Integral)\>\""}], "}"}]}], "]"}], ",", 
     RowBox[{"Frame", "->", "All"}]}], "]"}], "\n", "\n"}]}]], "Input",
 CellChangeTimes->{{3.9594077678630466`*^9, 3.959407767863372*^9}, {
